	<string>StormWatch NJ uses the camera so you can photograph a flooded street, blocked storm drain or downed tree. Photos are never published; each one is sent to OpenAI to read the scene.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>StormWatch NJ uses your location to show hazards within a few miles of you and to tag a report you choose to submit. Your location is never uploaded on its own.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>StormWatch NJ lets you attach an existing storm photo to a hazard report.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
