# Google AI Studio key for the Gemini vision triage endpoint.
GOOGLE_API_KEY=your-key-here

# Optional: override the model used by /api/v1/analyze-image.
GEMINI_MODEL=gemini-1.5-flash

# PostgreSQL + PostGIS connection string used by usgs_worker.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stormwatch

# Comma-separated API keys accepted by POST /georeport/v2/requests.json.
# Leave unset for open development mode; set it before exposing the API.
STORMWATCH_API_KEYS=

# Where reports are stored (SQLite). Defaults to backend/stormwatch.db.
STORMWATCH_DB=

# Optional email dispatch through Resend. Both must be set, or email is skipped.
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=
