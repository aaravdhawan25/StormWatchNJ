# Google AI Studio key for the Gemini vision triage endpoint.
GOOGLE_API_KEY=your-key-here

# Optional: override the model used by /api/v1/analyze-image.
GEMINI_MODEL=gemini-1.5-flash

# PostgreSQL + PostGIS connection string used by usgs_worker.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stormwatch
